# Rust build artifacts
/target/
**/target/

# Cargo lock (keep for binaries, optional for libs)
# Cargo.lock is committed for reproducible builds in this workspace

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Benchmark results (HTML reports)
/criterion/

# Generated test artifacts
tests/images/qr/*.png
tests/images/qr/*.jpg
tests/images/barcode_1d/*.png
tests/images/barcode_1d/*.jpg
tests/images/barcode_2d/*.png
tests/images/edge_cases/*.png
tests/images/edge_cases/*.jpg

# Keep the generator script
!tests/images/generate_test_images.py

# WASM build output
crates/scanner-wasm/pkg/
crates/scanner-wasm/demo/scanner_wasm_bg.wasm
crates/scanner-wasm/demo/scanner_wasm_bg.wasm.d.ts
crates/scanner-wasm/demo/scanner_wasm.js
crates/scanner-wasm/demo/scanner_wasm.d.ts

# Node.js native addon binaries
crates/scanner-napi/*.node
*.node

# Node modules & lock files (keep package-lock.json for reproducibility but ignore node_modules)
node_modules/
crates/scanner-napi/node_modules/

# Python virtualenv
venv/
.venv/
__pycache__/

# Environment
.env
.env.local

# Profiling
*.profdata
*.prof
